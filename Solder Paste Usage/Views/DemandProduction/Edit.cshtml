@model SolderPasteUsage.Models.DemandProduction

@{
    ViewData["Title"] = "Edit Demand Production";
}

<div class="dashboard-title">

    <h1>Edit Demand Production</h1>

    <p>
        Update production demand data
    </p>

</div>


<div class="form-card">

    <form asp-controller="DemandProduction"
          asp-action="Edit"
          asp-route-id="@Model.DemandId"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="DemandId" />


        <div asp-validation-summary="ModelOnly"
             class="validation-error">
        </div>


        <div class="form-grid">


            <div class="form-group">

                <label asp-for="Line">
                    Line
                </label>

                <input asp-for="Line"
                       class="form-control" />

                <span asp-validation-for="Line"
                      class="validation-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="WO">
                    Work Order
                </label>

                <input asp-for="WO"
                       class="form-control" />

                <span asp-validation-for="WO"
                      class="validation-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="ProjectName">
                    Project
                </label>

                <input asp-for="ProjectName"
                       class="form-control" />

                <span asp-validation-for="ProjectName"
                      class="validation-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Family">
                    Family
                </label>

                <input asp-for="Family"
                       class="form-control" />

                <span asp-validation-for="Family"
                      class="validation-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Quantity">
                    Quantity
                </label>

                <input asp-for="Quantity"
                       type="number"
                       class="form-control" />

                <span asp-validation-for="Quantity"
                      class="validation-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="UPH">
                    UPH
                </label>

                <input asp-for="UPH"
                       type="number"
                       class="form-control" />

                <span asp-validation-for="UPH"
                      class="validation-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="WOStart">
                    WO Start
                </label>

                <input asp-for="WOStart"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="WOStart"
                      class="validation-error">
                </span>

            </div>


        </div>


        <div class="form-actions">

            <a asp-controller="DemandProduction"
               asp-action="Index"
               class="btn-cancel">

                Cancel

            </a>


            <button type="submit"
                    class="btn-save">

                Save Changes

            </button>

        </div>


    </form>

</div>


@section Scripts
{

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}