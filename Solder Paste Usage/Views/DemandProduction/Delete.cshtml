@model SolderPasteUsage.Models.DemandProduction

@{
    ViewData["Title"] = "Delete Demand Production";
}

<div class="dashboard-title">

    <h1>Delete Demand Production</h1>

    <p>
        Confirm deletion of production demand data
    </p>

</div>


<div class="form-card delete-card">


    <div class="delete-warning">

        <h3>
            Are you sure you want to delete this data?
        </h3>

        <p>
            This action cannot be undone.
        </p>

    </div>


    <div class="detail-grid">


        <div class="detail-item">

            <span class="detail-label">
                Line
            </span>

            <span class="detail-value">
                @Model.Line
            </span>

        </div>


        <div class="detail-item">

            <span class="detail-label">
                Work Order
            </span>

            <span class="detail-value">
                @Model.WO
            </span>

        </div>


        <div class="detail-item">

            <span class="detail-label">
                Project
            </span>

            <span class="detail-value">
                @Model.ProjectName
            </span>

        </div>


        <div class="detail-item">

            <span class="detail-label">
                Family
            </span>

            <span class="detail-value">
                @Model.Family
            </span>

        </div>


        <div class="detail-item">

            <span class="detail-label">
                Quantity
            </span>

            <span class="detail-value">
                @Model.Quantity
            </span>

        </div>


        <div class="detail-item">

            <span class="detail-label">
                UPH
            </span>

            <span class="detail-value">
                @Model.UPH
            </span>

        </div>


        <div class="detail-item">

            <span class="detail-label">
                WO Start
            </span>

            <span class="detail-value">
                @Model.WOStart.ToString("dd/MM/yyyy HH:mm")
            </span>

        </div>


    </div>


    <form asp-controller="DemandProduction"
          asp-action="Delete"
          asp-route-id="@Model.DemandId"
          method="post">

        @Html.AntiForgeryToken()


        <div class="form-actions">

            <a asp-controller="DemandProduction"
               asp-action="Index"
               class="btn-cancel">

                Cancel

            </a>


            <button type="submit"
                    class="btn-delete-confirm">

                Yes, Delete

            </button>

        </div>


    </form>


</div>