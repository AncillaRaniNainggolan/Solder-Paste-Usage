@model IEnumerable<SolderPasteUsage.Models.WorkOrder>

<div class="page-header">
    <h2>Work Order</h2>
</div>

<div class="table-card">

    <table class="dashboard-table datatable">

        <thead>
            <tr>
                <th>WO Number</th>
                <th>Demand ID</th>
                <th>Project</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.WoNumber</td>
                    <td>@item.DemandId</td>
                    <td>@item.ProjectName</td>
                </tr>
            }

        </tbody>

    </table>

</div>