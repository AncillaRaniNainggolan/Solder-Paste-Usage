@using Microsoft.AspNetCore.Http

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Solder Paste Usage</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css"
          rel="stylesheet" />

    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css"
          rel="stylesheet" />

    <!-- Site -->
    <link href="~/css/site.css"
          rel="stylesheet"
          asp-append-version="true" />

</head>

<body>

    @{
        var role = Context.Session.GetString("Role");
        var username = Context.Session.GetString("Username");
    }

    <div class="wrapper">

       
        <aside class="sidebar">

            <div class="logo">

                <div class="logo-circle">
                    SP
                </div>

                <div>
                    <h3>Solder Paste</h3>
                    <span>Usage System</span>
                </div>

            </div>

            @if (role == "Engineer")
            {
                <div class="menu-section">

                    <p>OVERVIEW</p>

                    <ul class="menu">

                        <li>
                            <a asp-controller="Dashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li>
                            <a asp-controller="DemandProduction"
                               asp-action="Index">
                                Demand Production
                            </a>
                        </li>

                        <li>
                            <a asp-controller="WorkOrder"
                               asp-action="Index">
                                Work Order
                            </a>
                        </li>

                    </ul>

                </div>

                <div class="menu-section">

                    <p>USAGE DATA</p>

                    <ul class="menu">

                        <li>
                            <details>

                                <summary>Daily</summary>

                                <ul>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Daily"
                                           asp-route-period="today">
                                            Today
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Daily"
                                           asp-route-period="yesterday">
                                            Yesterday
                                        </a>
                                    </li>

                                </ul>

                            </details>
                        </li>

                        <li>

                            <details>

                                <summary>Weekly</summary>

                                <ul>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Weekly"
                                           asp-route-period="thisweek">
                                            This Week
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Weekly"
                                           asp-route-period="lastweek">
                                            Last Week
                                        </a>
                                    </li>

                                </ul>

                            </details>

                        </li>

                        <li>

                            <details>

                                <summary>Monthly</summary>

                                <ul>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Monthly"
                                           asp-route-period="thismonth">
                                            This Month
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Monthly"
                                           asp-route-period="lastmonth">
                                            Last Month
                                        </a>
                                    </li>

                                </ul>

                            </details>

                        </li>

                        <li>

                            <details>

                                <summary>Quarterly</summary>

                                <ul>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Quarterly"
                                           asp-route-period="thisquarter">
                                            This Quarter
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Quarterly"
                                           asp-route-period="lastquarter">
                                            Last Quarter
                                        </a>
                                    </li>

                                </ul>

                            </details>

                        </li>

                        <li>

                            <details>

                                <summary>Yearly</summary>

                                <ul>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Yearly"
                                           asp-route-period="thisyear">
                                            This Year
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-controller="UsageData"
                                           asp-action="Yearly"
                                           asp-route-period="lastyear">
                                            Last Year
                                        </a>
                                    </li>

                                </ul>

                            </details>

                        </li>

                    </ul>

                </div>

                <div class="menu-section">

                    <p>MATERIAL</p>

                    <ul class="menu">

                        <li>
                            <a asp-controller="MaterialOrder"
                               asp-action="Index">
                                Material Order
                            </a>
                        </li>

                    </ul>

                </div>
            }

            @if (role == "Warehouse")
            {
                <div class="menu-section">

                    <p>WAREHOUSE</p>

                    <ul class="menu">

                        <li>
                            <a asp-controller="Warehouse"
                               asp-action="Index">
                                Dashboard Warehouse
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Warehouse"
                               asp-action="MaterialOrders">
                                Material Orders
                            </a>
                        </li>

                    </ul>

                </div>
            }

        </aside>

        <div class="content-wrapper">

            <div class="topbar">

                <div class="topbar-title">
                    Solder Paste Usage Monitoring System
                </div>

                <div class="user-area">

                    <span class="user-role">
                        @role
                    </span>

                    <span class="user-name">
                        @username
                    </span>

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="logout-btn">
                        Logout
                    </a>

                </div>

            </div>

            <main class="main-content">

                @RenderBody()

            </main>

        </div>
   

    </div>

    <!-- JQuery -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables -->

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <!-- Datatable Init -->

    <script src="~/js/datatables-init.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
